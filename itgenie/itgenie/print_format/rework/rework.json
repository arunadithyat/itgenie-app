 "doctype": "Print Format",
 "font_size": 14,
 "html": "<html>\r\n<head>\r\n    <style>\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 13px;\r\n        }\r\n        td, th {\r\n            border: 1px solid #000;\r\n            padding: 6px;\r\n            vertical-align: top;\r\n        }\r\n        .title {\r\n            text-align: center;\r\n            font-weight: bold;\r\n            font-size: 18px;\r\n            margin-bottom: 10px;\r\n            padding: 5px;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n<!-- COMPANY LOGO BASED ON COMPANY -->\r\n{% if doc.company == \"Timbe Windows Private Limited\" %}\r\n    {% set logo = \"/files/image_2023_08_24T15_11_53_538Z.png\" %}\r\n{% elif doc.company == \"Doortisan Creations Private Limited\" %}\r\n    {% set logo = \"/files/image_2023_08_24T15_16_35_199Z.png\" %}\r\n{% else %}\r\n    {% set logo = \"/files/default_logo.png\" %}\r\n{% endif %}\r\n\r\n<div style=\"text-align:left; margin-bottom:10px;\">\r\n    <img src=\"{{ logo }}\" style=\"width:140px;\">\r\n</div>\r\n\r\n<div class=\"title\">Rework Approval Form</div>\r\n\r\n<!-- TOP SECTION -->\r\n<table>\r\n    <tr>\r\n        <td width=\"25%\">Date</td>\r\n        <td width=\"25%\">{{ doc.date }}</td>\r\n        <td width=\"25%\">Quotation No</td>\r\n        <td width=\"25%\">{{ doc.quotation }}</td>\r\n    </tr>\r\n\r\n\r\n    <tr>\r\n        <td width=\"25%\">Rework ID</td>\r\n        <td width=\"25%\">{{ doc.name }}</td>\r\n        <td width=\"25%\">Project</td>\r\n        <td width=\"25%\">{{ doc.project }}</td>\r\n    </tr>\r\n    <tr>\r\n    <td width=\"25%\">Stage Identified</td>\r\n    <td colspan=\"3\">{{ doc.rework_stage }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td>Customer Name</td>\r\n        <td colspan=\"3\">{{ doc.customer_name }}</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>Reason for Rework</td>\r\n        <td colspan=\"3\">{{ doc.reason_for_rework }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Problem / Description</td>\r\n        <td colspan=\"3\" style=\"height:120px;\">{{ doc.description }}</td>\r\n    </tr>\r\n    \r\n</table>\r\n\r\n<br>\r\n\r\n<!-- COST SECTION -->\r\n<!-- COST SECTION -->\r\n<table>\r\n    <tr>\r\n        <td width=\"25%\">Material Cost (\u20b9)</td>\r\n        <td width=\"25%\">{{ doc.material_cost }}</td>\r\n        <td width=\"25%\">Labour Cost (\u20b9)</td>\r\n        <td width=\"25%\">{{ doc.labour_cost }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Transport Cost (\u20b9)</td>\r\n        <td>{{ doc.transport_cost }}</td>\r\n        <td>Total Rework Cost(\u20b9)</td>\r\n        <td>\r\n            {{\r\n                (doc.material_cost or 0)\r\n                + (doc.labour_cost or 0)\r\n                + (doc.transport_cost or 0)\r\n            }}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Rework Cost Paid by Customer</td>\r\n        <td>\r\n            {% if doc.rework_paid_by_customer == 'Yes'%}\r\n                Yes\r\n            {% else %}\r\n                No\r\n            {% endif %}\r\n        </td>\r\n        <td>Cost Prepared By</td>\r\n        <td>\r\n    {{\r\n        frappe.db.get_value(\r\n            \"User\",\r\n            doc.owner,\r\n            \"full_name\"\r\n        )\r\n    }}\r\n</td>\r\n\r\n    </tr>\r\n</table>\r\n\r\n\r\n<br><br>\r\n\r\n<!-- REWORK ITEMS (Order Form item child table) -->\r\n{% if doc.rework_items %}\r\n<table>\r\n    <tr>\r\n        <th style=\"width:25%;\">Item</th>\r\n        <th style=\"width:50%;\">Item Name</th>\r\n        <th style=\"width:25%;\">Qty</th>\r\n    </tr>\r\n    {% for row in doc.rework_items %}\r\n    <tr>\r\n        <td>{{ row.item }}</td>\r\n        <td>{{ row.item_name }}</td>\r\n        <td style=\"text-align:right;\">{{ row.qty }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n</table>\r\n\r\n<br><br>\r\n\r\n{% set proj_sales_person = frappe.db.get_value(\"Project\", doc.project, \"custom_sales_person\") %}\r\n{% set proj_production_incharge = frappe.db.get_value(\"Project\", doc.project, \"custom_remark\") %}\r\n\r\n<table>\r\n    <tr>\r\n        <td>Sales Person</td>\r\n        <td colspan=\"3\">{{ proj_sales_person or \"-\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Production Incharge</td>\r\n        <td colspan=\"3\">{{ proj_production_incharge or \"-\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Operations Manager</td>\r\n        <td colspan=\"3\">\r\n            {% if doc.company == \"Doortisan Creations Private Limited\" %}\r\n                Velmurugan\r\n            {% elif doc.company == \"Timbe Windows Private Limited\" %}\r\n                M. Karthick \r\n            {% else %}\r\n                -\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>General Manager</td>\r\n        <td colspan=\"3\">Murugan D</td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n\r\n{% endif %}\r\n\r\n</body>\r\n</html>\r\n",
