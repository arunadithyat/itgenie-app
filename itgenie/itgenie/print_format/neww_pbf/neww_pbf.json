{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-18 11:23:18.043349",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 1,
 "doc_type": "Production Briefing Form",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n.print-toolbar,\r\n.page-head,\r\n.print-actions,\r\n.btn-print,\r\n.btn-pdf,\r\na[href*=\"print\"],\r\na[href*=\"pdf\"]{\r\n    display:none !important;\r\n}\r\n</style>\r\n\r\n{% if doc.doctype == 'Production Briefing Form' and doc.custom_company == \"Timbe Windows Private Limited\" %}\r\n<style>\r\n/* =========================\r\n   BASE TABLE STYLE\r\n========================= */\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 10.5px;\r\n}\r\n\r\nth, td {\r\n    border: 1px solid #000;\r\n    padding: 3px 4px;\r\n    vertical-align: top;\r\n}\r\n\r\nth {\r\n    background: #333 !important;\r\n    color: #fff !important;\r\n    text-align: center;\r\n    font-weight: bold;\r\n    font-size: 11px;\r\n    -webkit-print-color-adjust: exact !important;\r\n    print-color-adjust: exact !important;\r\n}\r\n\r\n.center {\r\n    text-align: center;\r\n}\r\n\r\n/* =========================\r\n   HEADER\r\n========================= */\r\n.header-title {\r\n    font-size: 26px;\r\n    font-weight: bold;\r\n    margin: 0;\r\n}\r\n\r\n/* =========================\r\n   DESCRIPTION BLOCK\r\n========================= */\r\ntd.desc-td {\r\n    padding: 0 !important;\r\n}\r\n\r\n.item-name {\r\n    font-weight: bold;\r\n    font-size: 11px;\r\n    padding: 4px 6px;\r\n    border-bottom: 1px solid #000;\r\n    background: #f9f9f9;\r\n}\r\n\r\n/*same format code below*/ \r\n/* === ULTRA COMPACT ROWS LIKE ITEM NAME === */\r\n.desc-table td {\r\n    /*padding: 1px 4px !important;*/\r\n    /*line-height: 1.05 !important;*/\r\n    padding: 2px 5px !important;   /* \u2b06 slightly increased */\r\n    line-height: 1.15 !important;  /* \u2b06 more breathing space */\r\n    font-size: 10px;\r\n}\r\n\r\n/* labels slightly bold but compact */\r\n.desc-label {\r\n    font-weight: 600;\r\n}\r\n\r\n/* section titles also compact */\r\n.section-title {\r\n    padding: 2px 6px !important;\r\n    font-size: 10px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================\r\n   DESCRIPTION TABLE (LIKE IMAGE-1)\r\n========================= */\r\n.desc-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 10px;\r\n}\r\n\r\n/*.desc-table td {*/\r\n/*    border: none;*/\r\n/*    border-bottom: 0.6px solid #000;*/\r\n/*    padding: 2px 6px;*/\r\n/*}*/\r\n\r\n.desc-label {\r\n    width: 40%;\r\n    font-weight: bold;\r\n}\r\n\r\n.desc-value {\r\n    width: 60%;\r\n}\r\n\r\n/* =========================\r\n   SECTION TITLES (INLINE)\r\n========================= */\r\n.section-title {\r\n    font-weight: bold;\r\n    background: #efefef;\r\n    padding: 3px 6px;\r\n    border-bottom: 1px solid #000;\r\n}\r\n\r\n/* =========================\r\n   IMAGE STYLE (TALL & DOMINANT)\r\n========================= */\r\n.img {\r\n    max-width: 95%;\r\n    max-height: 260px;\r\n    display: block;\r\n    margin: 4px auto;\r\n}\r\n\r\n/* =========================\r\n   HEADER TABLE \u2013 NO BORDERS\r\n========================= */\r\n.header-table,\r\n.header-table td {\r\n    border: none !important;\r\n}\r\n</style>\r\n\r\n<!-- =========================\r\n     HEADER\r\n========================= -->\r\n<table class=\"header-table\">\r\n    <tr>\r\n        <td style=\"width:40%;\">\r\n            <img src=\"/files/image_2023_08_24T15_11_53_538Z.png\" style=\"height:55px;\">\r\n        </td>\r\n        <td style=\"width:60%; text-align:right;\">\r\n            <div class=\"header-title\">Production Briefing Form</div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- =========================\r\n     BASIC DETAILS\r\n========================= -->\r\n<table style=\"margin-top:5px;\">\r\n    <tr>\r\n        <td><b>ID:</b> {{ doc.name }}</td>\r\n        <td style=\"text-align:right;\"><b>Quotation:</b> {{ doc.quotation }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td><b>Project:</b> {{ doc.project }}</td>\r\n        <td style=\"text-align:right;\"><b>Sales Person:</b> {{ doc.sales_person }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td><b>Delivery Date:</b> {{ frappe.utils.formatdate(doc.expected_delivery_date) }}</td>\r\n        <td></td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- =========================\r\n     ITEMS TABLE\r\n========================= -->\r\n<table style=\"margin-top:8px;\">\r\n    <tr>\r\n        <th style=\"width:6%;\">SL NO</th>\r\n        <th style=\"width:54%;\">DESCRIPTION</th>\r\n        <th style=\"width:6%;\">QTY</th>\r\n        <th style=\"width:34%;\">IMAGE</th>\r\n    </tr>\r\n\r\n    {% for row in doc.briefing_items %}\r\n    <tr>\r\n        <td class=\"center\">{{ loop.index }}</td>\r\n\r\n        <!-- ================= DESCRIPTION ================= -->\r\n        <td class=\"desc-td\">\r\n            <div class=\"item-name\">\r\n                {{ row.item_code }} \u2013 {{ row.item_name }}\r\n            </div>\r\n\r\n            <table class=\"desc-table\">\r\n                <tr><td colspan=\"2\" class=\"section-title\">LOCATION DETAILS</td></tr>\r\n                <tr><td class=\"desc-label\">Floor</td><td class=\"desc-value\">{{ row.custom_floor or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Place Type</td><td class=\"desc-value\">{{ row.custom_type or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Place</td><td class=\"desc-value\">{{ row.custom_place or \"N/A\" }}</td></tr>\r\n                \r\n                <tr>\r\n                    <td class=\"desc-label\">Window / Door No</td>\r\n                    <td class=\"desc-value\">\r\n                        {% if row.custom_windowdoor_no %}\r\n                            {% set item_group = frappe.db.get_value(\"Item\", row.item_code, \"item_group\") %}\r\n                            \r\n                            {% if item_group == \"Upvc Ventilators\" %}\r\n                                V{{ row.custom_windowdoor_no }}\r\n                            {% elif item_group == \"uPVC Windows\" %}\r\n                                W{{ row.custom_windowdoor_no }}\r\n                            {% elif item_group == \"Upvc Doors\" %}\r\n                                D{{ row.custom_windowdoor_no }}\r\n                            {% else %}\r\n                                C{{ row.custom_windowdoor_no }}\r\n                            {% endif %}\r\n                        {% else %}\r\n                            N/A\r\n                        {% endif %}\r\n                    </td>\r\n                </tr>\r\n\r\n                <tr><td class=\"desc-label\">Qty</td><td class=\"desc-value\">{{ row.quantity }}</td></tr>\r\n\r\n                <tr><td colspan=\"2\" class=\"section-title\">MEASUREMENT DETAILS</td></tr>\r\n\r\n                {# ================= WIDTH ================= #}\r\n                {% set widths = [] %}\r\n                {% if row.custom_width_1 %}{% set _ = widths.append(row.custom_width_1 | int) %}{% endif %}\r\n                {% if row.custom_width_2 %}{% set _ = widths.append(row.custom_width_2 | int) %}{% endif %}\r\n                {% if row.custom_width_3 %}{% set _ = widths.append(row.custom_width_3 | int) %}{% endif %}\r\n                \r\n                <tr>\r\n                    <td class=\"desc-label\">Width</td>\r\n                    <td class=\"desc-value\">\r\n                        {% if row.custom_width_1 %}W1-{{ row.custom_width_1 }}{% endif %}\r\n                        {% if row.custom_width_2 %} / W2-{{ row.custom_width_2 }}{% endif %}\r\n                        {% if row.custom_width_3 %} / W3-{{ row.custom_width_3 }}{% endif %}\r\n                    </td>\r\n                </tr>\r\n                \r\n                {% if widths | length > 1 %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Width Variance</td>\r\n                    <td class=\"desc-value\">{{ widths|max - widths|min }} mm</td>\r\n                </tr>\r\n                {% endif %}\r\n                \r\n                {# ================= HEIGHT ================= #}\r\n                {% set heights = [] %}\r\n                {% if row.custom_height_1 %}{% set _ = heights.append(row.custom_height_1 | int) %}{% endif %}\r\n                {% if row.custom_height_2 %}{% set _ = heights.append(row.custom_height_2 | int) %}{% endif %}\r\n                {% if row.custom_height_3 %}{% set _ = heights.append(row.custom_height_3 | int) %}{% endif %}\r\n                \r\n                <tr>\r\n                    <td class=\"desc-label\">Height</td>\r\n                    <td class=\"desc-value\">\r\n                        {% if row.custom_height_1 %}H1-{{ row.custom_height_1 }}{% endif %}\r\n                        {% if row.custom_height_2 %} / H2-{{ row.custom_height_2 }}{% endif %}\r\n                        {% if row.custom_height_3 %} / H3-{{ row.custom_height_3 }}{% endif %}\r\n                    </td>\r\n                </tr>\r\n                \r\n                {% if heights | length > 1 %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Height Variance</td>\r\n                    <td class=\"desc-value\">{{ heights|max - heights|min }} mm</td>\r\n                </tr>\r\n                {% endif %}\r\n                \r\n                {# ===== SQUARE FEET (LOWEST WIDTH \u00d7 LOWEST HEIGHT) ===== #}\r\n                {% if widths and heights %}\r\n                {% set min_width = widths|min %}\r\n                {% set min_height = heights|min %}\r\n                {% set sqft = (min_width * min_height) / 92903.04 %}\r\n                \r\n                <tr>\r\n                    <td class=\"desc-label\">Square Feet</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"%.2f\"|format(sqft) }} sq.ft\r\n                        <span style=\"font-size:9px;\">\r\n                            ({{ min_width }} \u00d7 {{ min_height }} mm)\r\n                        </span>\r\n                    </td>\r\n                </tr>\r\n                {% endif %}\r\n\r\n                <tr><td class=\"desc-label\">Unit Of Measure</td><td class=\"desc-value\">{{ row.custom_unit_choice or \"N/A\" }}</td></tr>\r\n\r\n                <tr><td colspan=\"2\" class=\"section-title\">GLASS DETAILS</td></tr>\r\n                <tr><td class=\"desc-label\">Glass Type</td><td class=\"desc-value\">{{ row.custom_glass_type or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Glass Thickness</td><td class=\"desc-value\">{{ row.custom_glass_thickness or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Glass Color</td><td class=\"desc-value\">{{ row.custom_glass_color or \"N/A\" }}</td></tr>\r\n\r\n                <!--Below code for depends on display-->\r\n                {% set item_name_lc = (row.item_name or \"\").lower() %}\r\n                {% set is_sliding = \"sliding\" in item_name_lc %}\r\n                {% set is_fixed_window = \"fixed window\" in item_name_lc %}\r\n                \r\n                {% set item_name_lc = (row.item_name or \"\").lower() %}\r\n                {% set show_fan = (\"ventilator\" in item_name_lc) or (\"louver\" in item_name_lc) %}\r\n\r\n                <tr><td colspan=\"2\" class=\"section-title\">HARDWARE</td></tr>\r\n                \r\n                {% if not is_sliding and not is_fixed_window %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Hinges</td>\r\n                    <td class=\"desc-value\">{{ row.custom_hinges or \"N/A\" }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                \r\n                {% if not is_fixed_window %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Handle</td>\r\n                    <td class=\"desc-value\">{{ row.custom_handle or \"N/A\" }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                \r\n                {% if not is_sliding and not is_fixed_window %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Opening</td>\r\n                    <td class=\"desc-value\">{{ row.custom_opening or \"N/A\" }}</td>\r\n                </tr>\r\n                {% endif %}\r\n\r\n                <tr><td class=\"desc-label\">uPVC Type</td><td class=\"desc-value\">{{ row.custom_upvc_type or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Toughen</td><td class=\"desc-value\">{{ row.custom_toughen or \"N/A\" }}</td></tr>\r\n                \r\n                {% if show_fan %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Fan</td>\r\n                    <td class=\"desc-value\">{{ row.custom_fan or \"N/A\" }}</td>\r\n                </tr>\r\n                {% endif %}\r\n\r\n                <tr><td class=\"desc-label\">Wall Thickness</td><td class=\"desc-value\">{{ row.custom_wall_thickness or \"N/A\" }}</td></tr>\r\n                \r\n                <tr><td colspan=\"2\" class=\"section-title\">REMARKS</td></tr>\r\n                <tr><td class=\"desc-label\">Remarks</td><td class=\"desc-value\">{{ row.additional_remarks or \"N/A\" }}</td></tr>\r\n            </table>\r\n        </td>\r\n\r\n        <!-- ================= QTY ================= -->  \r\n        <td class=\"center\">{{ row.quantity }}</td>\r\n\r\n        <!-- ================= IMAGE ================= -->\r\n        <td class=\"center\">\r\n            {% set item_image = frappe.db.get_value(\"Item\", row.item_code, \"image\") %}\r\n            {% if item_image %}\r\n            <img src=\"{{ frappe.utils.get_url() }}{{ item_image }}\" class=\"img\">\r\n            {% endif %}\r\n\r\n            {% set measurement_names = frappe.get_all(\r\n                \"Measurement\",\r\n                filters={\"project\": doc.project},\r\n                pluck=\"name\"\r\n            ) %}\r\n\r\n            {% for m in measurement_names %}\r\n            {% set matched_measurement_item = frappe.get_all(\r\n                \"Installation Request Item\",\r\n                filters={\r\n                    \"parent\": m,\r\n                    \"custom_item_name\": row.item_name\r\n                },\r\n                fields=[\"custom_attach\"],\r\n                limit=1\r\n            ) %}\r\n\r\n            {% if matched_measurement_item and matched_measurement_item[0].custom_attach %}\r\n            <img src=\"{{ frappe.utils.get_url() }}{{ matched_measurement_item[0].custom_attach }}\"\r\n                 class=\"img\">\r\n            {% endif %}\r\n            {% endfor %}\r\n        </td>\r\n    </tr>\r\n\r\n    {% if not loop.last %}\r\n    <tr>\r\n        <td colspan=\"4\" style=\"border:none;\">\r\n            <div style=\"page-break-after:always;height:1px;\"></div>\r\n        </td>\r\n    </tr>\r\n    {% endif %}\r\n    {% endfor %}\r\n</table>\r\n{% endif %}\r\n\r\n{% if doc.doctype == 'Production Briefing Form'%}\r\n<style>\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 11px;              /* base increased */\r\n    }\r\n    th, td {\r\n        border:1px solid #000 ;\r\n        /*padding: 5px;*/\r\n        /*vertical-align: top;*/\r\n        /*1px solid #000*/\r\n    }\r\n    th {\r\n        background: #333333 !important;\r\n        color: #ffffff !important;\r\n        text-align: center;\r\n        font-weight: bold;\r\n        -webkit-print-color-adjust: exact !important;\r\n        print-color-adjust: exact !important;\r\n    }\r\n    .center {\r\n        text-align: center;\r\n    }\r\n    td.desc-td {\r\n        padding: 0 !important;\r\n        margin: 0 !important;\r\n    }\r\n    .item-name {\r\n        font-weight: bold;\r\n        font-size: 11px;              /* increased */\r\n        padding: 5px 6px 3px 6px;     /* more vertical breathing room */\r\n        margin: 0;\r\n        border-bottom: 1px solid #000;\r\n        line-height: 1.3;\r\n    }\r\n    .desc-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 10.5px;            /* increased from 10px */\r\n        margin: 0;\r\n        padding: 0;\r\n        border: none;\r\n    }\r\n    .desc-table tr {\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n    .desc-table td {\r\n        border: none;\r\n        border-bottom: 0.8px solid #000;\r\n        padding: 3px 5px !important;   /* vertical padding increased */\r\n        line-height: 1.25;             /* more comfortable line spacing */\r\n        margin: 0;\r\n        vertical-align: top;\r\n    }\r\n    .desc-label {\r\n        width: 38%;\r\n        text-align: left;\r\n        border-right: 1px solid #000 !important;\r\n        border-left: none !important;\r\n        padding: 3px 5px 3px 6px !important;\r\n        vertical-align: top;\r\n    }\r\n    .desc-value {\r\n        width: 62%;\r\n        text-align: left;\r\n        border-left: none !important;\r\n        padding: 3px 6px !important;\r\n        white-space: normal;\r\n        word-wrap: break-word;\r\n        line-height: 1.25;\r\n    }\r\n    .img-title {\r\n        font-weight: bold;\r\n        font-size: 10px;\r\n        text-align: center;\r\n        margin-bottom: 4px;\r\n    }\r\n    .img {\r\n        width: 100%; /* \u4fee\u6539\u4e3a100%\u5bbd\u5ea6 */\r\n        height: auto; /* \u9ad8\u5ea6\u81ea\u52a8\u8c03\u6574\uff0c\u4fdd\u6301\u6bd4\u4f8b */\r\n        object-fit: contain; /* \u6539\u4e3acontain\uff0c\u786e\u4fdd\u5b8c\u6574\u663e\u793a */\r\n        display: block;\r\n        margin: auto;\r\n        min-height: 200px; /* \u8bbe\u7f6e\u6700\u5c0f\u9ad8\u5ea6 */\r\n    }\r\n    /* \u65b0\u589e\u56fe\u7247\u5bb9\u5668\u6837\u5f0f */\r\n    .img-container {\r\n        width: 100%;\r\n        height: 100%;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n        align-items: center;\r\n        overflow: hidden;\r\n    }\r\n</style>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse;\">\r\n    <tr>\r\n        <td style=\"width: 35%; border:1px solid #000; border-right: none;\">\r\n            <img src=\"/files/image_2023_08_24T15_16_35_199Z.png\" style=\"height: 50px;\">\r\n        </td>\r\n        <td style=\"width: 55%; text-align: right; border:1px solid #000; border-left: none;\">\r\n            <h2 style=\"margin: 0; font-weight: bold; font-size: 25px;\">\r\n                Production Briefing Form\r\n            </h2>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"section-title\"> </div>\r\n\r\n<table style=\"width: 100%; font-size: 11px; table-layout: fixed;\">\r\n    <tr>\r\n        <td style=\"width:50%;\">\r\n            <strong class=\"lbl\">ID:</strong> {{ doc.name }}\r\n        </td>\r\n        <td style=\"width:50%;\">\r\n            <strong class=\"lbl\">Quotation:</strong> {{ doc.quotation }}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>\r\n            <strong class=\"lbl\">Project:</strong> {{ doc.project }}\r\n        </td>\r\n        <td>\r\n            <strong class=\"lbl\">Sales Person:</strong> {{ doc.sales_person }}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>\r\n            <strong class=\"lbl\">Delivery Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.expected_delivery_date) }}\r\n        </td>\r\n        <td>\r\n            <strong class=\"lbl\">Customer:</strong>\r\n            {% if doc.quotation %}\r\n                {% set quotation = frappe.get_doc(\"Quotation\", doc.quotation) %}\r\n                {{ quotation.customer_name }}\r\n            {% else %}\r\n                Unknown\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>\r\n            <strong class=\"lbl\">Sales Confirmation Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.sales_confirmation_date) }}\r\n        </td>\r\n        <td>\r\n            <strong class=\"lbl\">Production Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.approved_date) }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n<table>\r\n    <tr>\r\n        <th style=\"width:6%;\">SL NO</th>\r\n        <th style=\"width:50%;\">DESCRIPTION</th>\r\n        <th style=\"width:10%;\">QUANTITY</th>\r\n        <th style=\"width:34%;\">IMAGE</th> <!-- \u8c03\u6574\u56fe\u7247\u5217\u5bbd\u5ea6 -->\r\n    </tr>\r\n\r\n    {% for row in doc.briefing_items or [] %}\r\n    <tr>\r\n        <td class=\"center\">{{ loop.index }}</td>\r\n        <td class=\"desc-td\">\r\n            <div class=\"item-name\">{{ row.item_name }}</div>\r\n            <table class=\"desc-table\">\r\n                <tr><td class=\"desc-label\">Code:</td><td class=\"desc-value\">{{ row.item_code or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Application:</td><td class=\"desc-value\">{{ row.application or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Floor:</td><td class=\"desc-value\">{{ row.item_name or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Place of Fixing:</td><td class=\"desc-value\">{{ row.application or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Door Type:</td><td class=\"desc-value\">{{ row.item_name or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Product Type:</td><td class=\"desc-value\">{{ row.product or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Shutter Type:</td><td class=\"desc-value\">{{ row.shutter_type or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Open Type:</td><td class=\"desc-value\">{{ row.custom_open_type or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Product Grade:</td><td class=\"desc-value\">{{ row.flush_grade or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Product Size:</td><td class=\"desc-value\">{{ row.product_size or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Thickness:</td><td class=\"desc-value\">{{ row.product_thickness or \"N/A\" }}</td></tr>\r\n                \r\n                <!-- LAMINATED DOOR DESIGN section - only show if laminate is selected -->\r\n                {% if row.laminate == 1 or row.custom_laminates %}\r\n\r\n                {% set front_side = row.custom_laminates.split(\"Back Side:\")[0].strip() if row.custom_laminates else \"\" %}\r\n                {% set back_side = row.custom_laminates.split(\"Back Side:\")[1].strip() if row.custom_laminates and \"Back Side:\" in row.custom_laminates else \"\" %}\r\n            \r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        LAMINATED DOOR DESIGN\r\n                    </td>\r\n                </tr>\r\n            \r\n                {% if row.laminate_thickness %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Laminate Thickness:</td>\r\n                    <td class=\"desc-value\">{{ row.laminate_thickness }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            \r\n                {% if front_side %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Front Side Code:</td>\r\n                    <td class=\"desc-value\">{{ front_side }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            \r\n                {% if back_side %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Back Side Code:</td>\r\n                    <td class=\"desc-value\">{{ back_side }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            \r\n            {% endif %}\r\n\r\n                {% if row.category == \"Wood\" %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        WOOD DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Wood Grade:</td><td class=\"desc-value\">{{ row.wood_grade or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Wood Type:</td><td class=\"desc-value\">{{ row.wood_type or \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                {% if row.category == \"WPC\" %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        WPC COLOR DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">WPC Color:</td><td class=\"desc-value\">{{ row.wpc_colour or \"N/A\" }}</td></tr>\r\n                \r\n                {% endif %}\r\n                \r\n                \r\n                <!-- CARVING DETAILS section - only show if carving is selected -->\r\n                {% if row.polish == 1 %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        POLISH DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"desc-label\">Polish:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.polish == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Polish Type:</td><td class=\"desc-value\">{{ row.polish_code_with_finish or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Color Code:</td><td class=\"desc-value\">{{row.color_code or \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                {% if row.carving == 1 %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        CARVING DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"desc-label\">Carving:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.carving == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Carving Type:</td><td class=\"desc-value\">{{ row.carving_details or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Carving Bit Thickness:</td><td class=\"desc-value\">{{  \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                {% if row.ornaments == 1 %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        ORNAMENT DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"desc-label\">Ornament:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.ornaments == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Ornament Details:</td><td class=\"desc-value\">{{ row.ornaments_details or \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                {% if row.hardware == 1 %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        HARDWARE DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"desc-label\">Hardware:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.hardware == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Harware Details:</td><td class=\"desc-value\">{{ row.hardware_details or \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                \r\n                <!-- Beading section - only show if beading is selected -->\r\n                {% if row.beading == 1 %}\r\n                <tr>\r\n                    <td class=\"desc-label\">Beading:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.beading == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Beading Type:</td><td class=\"desc-value\">{{ row.beading_details or \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n                 \r\n                <!-- PRODUCTION MEASUREMENT section -->\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        PRODUCTION MEASUREMENT\r\n                    </td>\r\n                </tr>\r\n                \r\n                <tr>\r\n                    <td class=\"desc-label\">Measurements Details:</td>\r\n                    <td class=\"desc-value\" style=\"white-space: pre-line;\">\r\n                        {{ row.production_measurements or \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n\r\n                <tr>\r\n                    <td class=\"desc-label\">Remarks:</td>\r\n                    <td class=\"desc-value\" style=\"white-space: pre-line;\">\r\n                        {{ row.additional_remarks or \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n<!-- ADDITIONAL DETAILS section - only show if glass is selected -->\r\n                {% if row.glass == 1 %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"font-weight:900; background-color:#333333; color:#ffffff; padding:4px 3px !important; text-align:center; font-size:10px; letter-spacing:0.5px; border:1px solid #333;\">\r\n                        ADDITIONAL DETAILS\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td class=\"desc-label\">Glass:</td>\r\n                    <td class=\"desc-value\">\r\n                        {{ \"Include\" if row.glass == 1 else \"N/A\" }}\r\n                    </td>\r\n                </tr>\r\n                <tr><td class=\"desc-label\">Glass Type:</td><td class=\"desc-value\">{{ row.glass_details or \"N/A\" }}</td></tr>\r\n                <tr><td class=\"desc-label\">Glass Thickness:</td><td class=\"desc-value\">{{ \"N/A\" }}</td></tr>\r\n                {% endif %}\r\n            </table>\r\n        </td>\r\n        <td class=\"center\">{{ row.quantity or \"0\" }}</td>\r\n        <td style=\"text-align: center; vertical-align: top; padding: 5px;\"> <!-- \u6dfb\u52a0\u5185\u8fb9\u8ddd -->\r\n            <div class=\"img-container\"> <!-- \u4f7f\u7528\u65b0\u7684\u56fe\u7247\u5bb9\u5668 -->\r\n                {% if row.product_design %}\r\n                <img src=\"{{ frappe.utils.get_url() }}{{ row.product_design }}\" class=\"img\">\r\n                {% endif %}\r\n               \r\n                {% if row.custom_edited_image %}\r\n                <img src=\"{{ frappe.utils.get_url() }}{{ row.custom_edited_image }}\" class=\"img\">\r\n                {% endif %}\r\n            </div>\r\n        </td>\r\n    </tr>\r\n\r\n    {% if not loop.last %}\r\n    <tr>\r\n        <td colspan=\"4\" style=\"border:none; padding:0;\">\r\n            <div style=\"page-break-after: always;\"></div>\r\n        </td>\r\n    </tr>\r\n    {% endif %}\r\n    {% endfor %}\r\n</table>   \r\n{% endif %}",
