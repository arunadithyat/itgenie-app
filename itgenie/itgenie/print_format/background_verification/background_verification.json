 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n  .title {\r\n    text-align: center;\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    margin-bottom: 20px;\r\n    text-decoration: underline;\r\n  }\r\n  .section-title {\r\n    font-size: 16px;\r\n    font-weight: bold;\r\n    margin-top: 20px;\r\n  }\r\n  .label-col {\r\n    width: 30%;\r\n    font-weight: bold;\r\n  }\r\n  .data-col {\r\n    width: 70%;\r\n  }\r\n  table {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    margin-bottom: 15px;\r\n  }\r\n  table, th, td {\r\n    border: 1px solid #ddd;\r\n    padding: 6px;\r\n  }\r\n  .no-border-table td, \r\n.no-border-table tr, \r\n.no-border-table th, \r\n.no-border-table {\r\n  border: none !important;\r\n  border-collapse: collapse !important;\r\n  padding: 4px !important;\r\n}\r\n\r\n</style>\r\n\r\n<div style=\"font-family:Arial, sans-serif; padding: 10px; font-size: 13px;\">\r\n  <h3 style=\"text-align:center;\">Homegenie Building Products Pvt. Ltd.</h3>\r\n  <h4 style=\"text-align:center;\">Background Verification (BGV) \u2013 Feedback Form</h4>\r\n  <hr>\r\n\r\n<!-- Section A: Candidate -->\r\n<div class=\"section-title\">Section A: Candidate Information</div>\r\n<table>\r\n  <tr>\r\n    <td class=\"label-col\">Candidate Name:</td>\r\n    <td class=\"data-col\">{{ doc.applicant_name or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Designation:</td>\r\n    <td class=\"data-col\">{{ doc.designation or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Department:</td>\r\n    <td class=\"data-col\">{{ doc.department or '' }}</td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- Section B: Referee -->\r\n<div class=\"section-title\">Section B: Referee Information</div>\r\n<table>\r\n  <tr>\r\n    <td class=\"label-col\">Referee Name:</td>\r\n    <td class=\"data-col\">{{ doc.name_of_referee or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Designation:</td>\r\n    <td class=\"data-col\">{{ doc.referee_designation or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Department:</td>\r\n    <td class=\"data-col\">{{ doc.department or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Organization:</td>\r\n    <td class=\"data-col\">{{ doc.organization or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Professional Relationship:</td>\r\n    <td class=\"data-col\">{{ doc.professional_relationship or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Period of Association:</td>\r\n    <td class=\"data-col\">{{ doc.period_of_association or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Official Email ID:</td>\r\n    <td class=\"data-col\">{{ doc.official_email_id or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Contact Number:</td>\r\n    <td class=\"data-col\">{{ doc.contact_number or '' }}</td>\r\n  </tr>\r\n</table>\r\n\r\n<!-- Section C: Performance Evaluation -->\r\n<div class=\"section-title\">Section C: Performance Evaluation</div>\r\n<table>\r\n  <thead>\r\n    <tr>\r\n      <th><strong>Competancy Area</strong></th>\r\n      <th><strong>Comments by Referee</strong></th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% if doc.competancy_area %}\r\n      {% for row in doc.competancy_area %}\r\n        <tr>\r\n          <td>{{ row.competency_area or '' }}</td>\r\n          <td>{{ row.comments_by_referee or '' }}</td>\r\n        </tr>\r\n      {% endfor %}\r\n    {% else %}\r\n      <tr>\r\n        <td colspan=\"2\">No evaluation data available.</td>\r\n      </tr>\r\n    {% endif %}\r\n  </tbody>\r\n</table>\r\n\r\n<!-- Section D: Overall Assessment -->\r\n<div class=\"section-title\">Section D: Overall Assessment</div>\r\n<table>\r\n  <thead>\r\n    <tr>\r\n      <th style=\"width: 30%\"><strong>Assessment Area</strong></th>\r\n      <th style=\"width: 70%\"><strong>rating / comment</strong></th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    <tr>\r\n      <td>Overall Performance Rating:</td>\r\n      <td>{{ doc.overall_performance_rating or '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td>Willingness to Rehire:</td>\r\n      <td>{{ doc.willingness_to_rehire or '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td>Additional Comments:</td>\r\n      <td>{{ doc.additional_comments or '' }}</td>\r\n    </tr>\r\n  </tbody>\r\n</table>\r\n\r\n<!-- Verification -->\r\n<table class=\"no-border-table\">\r\n  <tr>\r\n    <td class=\"label-col\">Verified:</td>\r\n    <td class=\"data-col\">{{ doc.hr_verifier or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">HR Dept:</td>\r\n    <td class=\"data-col\">HR Department</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Signature:</td>\r\n    <td class=\"data-col\">{{ doc.signature or '' }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td class=\"label-col\">Date:</td>\r\n    <td class=\"data-col\">{{ frappe.format_date(doc.date) if doc.date else '' }}</td>\r\n  </tr>\r\n</table>\r\n",
