{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-12-08 10:10:25.301625",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Measurement",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n  /*@page { size: A4 landscape; margin: 12mm; }*/\r\n  /*html, body { margin:0; padding:0; background:#fff; }*/\r\n  .sheet { font-family: Helvetica, Arial, sans-serif; font-size: 9.5px; line-height:1.25; color:#1f2937; }\r\n\r\n  /*.head { width:270mm; margin:0 auto 6mm auto; }*/\r\n  .head h1 { margin:0 0 4px 0; font-size:14px; letter-spacing:.3px; text-align:center; }\r\n  .kv { width:100%; border-collapse:collapse; }\r\n  .kv td { padding:2px 6px; vertical-align:top; border:0; }\r\n\r\n  /*table.grid { width:270mm; margin:0 auto; border-collapse:collapse; table-layout:fixed; }*/\r\n  .grid th, .grid td { border:0.6pt solid #111; padding:3px 4px; vertical-align:top; }\r\n  .grid th { background:#f3f4f6; text-align:center; vertical-align:middle; font-weight:600; }\r\n  .center { text-align:center; }\r\n  .nowrap { white-space:nowrap; }\r\n  .sub { font-size:8.5px; color:#6b7280; }\r\n  tr { page-break-inside:avoid; }\r\n  * { box-sizing:border-box; }\r\n  .imgbox { text-align:center; }\r\n  .imgbox img { max-width:100%; max-height:22mm; object-fit:contain; display:inline-block; }\r\n  \r\n  \r\n  \r\n  \r\n  @page {\r\n    size: A4 landscape;\r\n    margin: 5mm; /* Reduced margin for full page width */\r\n}\r\n\r\nhtml, body {\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n.head {\r\n    width: 100%;\r\n    margin: 0 0 4mm 0; /* Removed center alignment */\r\n}\r\n\r\ntable.grid {\r\n    width: 100%;\r\n    margin: 0;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n}\r\n\r\n\r\n/*below style for h & w displaying*/\r\n\r\n.attach-wrap {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 28mm;               /* Bigger for clarity */\r\n  /*border: 0.6pt solid #888;*/\r\n  border: none;              /* \u2705 REMOVE BORDER */\r\n  background: #fff;\r\n  overflow: hidden;          /* \u2705 trims arrows cleanly */\r\n}\r\n\r\n.attach-wrap img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n/* =========================\r\n   COMMON LABEL STYLE\r\n========================= */\r\n.dim-label {\r\n  position: absolute;\r\n  font-size: 7.5px;\r\n  font-weight: 600;\r\n  color: #fff;\r\n  background: rgba(17,24,39,0.85);\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  white-space: nowrap;\r\n  z-index: 3;\r\n}\r\n\r\n/* =========================\r\n   HORIZONTAL LINES (WIDTH)\r\n========================= */\r\n.h-line {\r\n  position: absolute;\r\n  left: 6%;\r\n  right: 6%;\r\n  height: 0;\r\n  border-top: 1.2pt solid #22c55e; /* green */\r\n  z-index: 2;\r\n}\r\n\r\n.h-line::before,\r\n.h-line::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: -4px;\r\n  width: 0;\r\n  height: 0;\r\n  border-top: 4px solid transparent;\r\n  border-bottom: 4px solid transparent;\r\n}\r\n\r\n.h-line::before {\r\n  left: -6px;\r\n  border-right: 6px solid #22c55e;\r\n}\r\n\r\n.h-line::after {\r\n  right: -6px;\r\n  border-left: 6px solid #22c55e;\r\n}\r\n\r\n/* Width positions */\r\n.w1-line { top: 12%; }\r\n.w2-line { top: 50%; }\r\n.w3-line { bottom: 12%; }\r\n\r\n/* =========================\r\n   VERTICAL LINES (HEIGHT)\r\n========================= */\r\n.v-line {\r\n  position: absolute;\r\n  top: 6%;\r\n  bottom: 6%;\r\n  width: 0;\r\n  border-left: 1.2pt solid #f97316; /* orange */\r\n  z-index: 2;\r\n}\r\n\r\n.v-line::before,\r\n.v-line::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: -4px;\r\n  width: 0;\r\n  height: 0;\r\n  border-left: 4px solid transparent;\r\n  border-right: 4px solid transparent;\r\n}\r\n\r\n.v-line::before {\r\n  top: -6px;\r\n  border-bottom: 6px solid #f97316;\r\n}\r\n\r\n.v-line::after {\r\n  bottom: -6px;\r\n  border-top: 6px solid #f97316;\r\n}\r\n\r\n/* Height positions */\r\n.h1-line { left: 12%; }\r\n.h2-line { left: 50%; }\r\n.h3-line { right: 12%; }\r\n\r\n\r\n  \r\n</style>\r\n\r\n<div class=\"sheet\">\r\n  <div class=\"head\">\r\n    <h1><b>Measurement Sheet</b></h1>\r\n    <table class=\"kv\">\r\n      <tr>\r\n        <td><b>Scheduled Date</b>: {{ frappe.utils.format_date(doc.scheduled_date or doc.posting_date) if (doc.scheduled_date or doc.posting_date) else \"-\" }}</td>\r\n        <!--<td><b>Customer</b>: {{ doc.customer_name or doc.customer or \"-\" }}</td>-->\r\n        <td>\r\n          \r\n          <b>Delivery Date</b>:\r\n          {% set proj_end_date = frappe.db.get_value(\"Project\", doc.project, \"expected_end_date\") %}\r\n          {{ frappe.utils.format_date(proj_end_date) if proj_end_date else \"-\" }}\r\n        </td>\r\n\r\n        \r\n        \r\n        <td><b>Quotation</b>: {{ doc.quotation_no or \"-\" }}</td>\r\n        \r\n        <td><b>Project ID</b>: {{ doc.project or \"-\" }}</td>\r\n        <td><b>Sales Person</b>: {{ doc.sales_person or \"-\" }}</td>\r\n        <td class=\"nowrap\"><b>Measurement ID</b>: {{ doc.name }}</td>\r\n      </tr>\r\n    </table>\r\n  </div>\r\n\r\n  <table class=\"grid\">\r\n    <!-- TOTAL = 270mm -->\r\n    <colgroup>\r\n      <col style=\"width:10mm;\">   <!-- S.NO -->\r\n      <col style=\"width:26mm;\">  <!-- ITEM CODE -->\r\n      <col style=\"width:20mm;\">  <!-- ITEM IMAGE -->\r\n      <col style=\"width:25mm;\">  <!-- IMAGE ATTACH -->\r\n      <col style=\"width:26mm;\">  <!-- LOCATION -->\r\n      <col style=\"width:20mm;\">  <!-- WIDTH -->\r\n      <col style=\"width:15mm;\">   <!-- \u0394W -->\r\n      <col style=\"width:20mm;\">  <!-- HEIGHT -->\r\n      <col style=\"width:15mm;\">   <!-- \u0394H -->\r\n      <col style=\"width:15mm;\">   <!-- WALL THICK -->\r\n      <col style=\"width:20mm;\">  <!-- PROFILE -->\r\n      <col style=\"width:13mm;\">  <!-- LOCK -->\r\n      <col style=\"width:16mm;\">  <!-- HANDLE -->\r\n      <col style=\"width:16mm;\">  <!-- HINGES -->\r\n      <col style=\"width:21mm;\">  <!-- GLASS + THICKNESS -->\r\n      <col style=\"width:27mm;\">  <!-- REMARKS -->\r\n    </colgroup>\r\n\r\n    <thead>\r\n      <tr>\r\n        <th rowspan=\"2\">S.NO</th>\r\n        <th rowspan=\"2\">ITEM CODE</th>\r\n        <th rowspan=\"2\">IMAGE</th>\r\n        <th rowspan=\"2\">IMAGE ATTACH</th>\r\n        <th rowspan=\"2\">LOCATION<br><span class=\"sub\">Floor \u2022 Place \u2022 Type</span></th>\r\n        <th rowspan=\"2\">WIDTH<br><span class=\"sub\">(W1/W2/W3)</span></th>\r\n        <th rowspan=\"2\">\u0394W<br><span class=\"sub\">max\u2212min</span></th>\r\n        <th rowspan=\"2\">HEIGHT<br><span class=\"sub\">(H1/H2/H3)</span></th>\r\n        <th rowspan=\"2\">\u0394H<br><span class=\"sub\">max\u2212min</span></th>\r\n        <th rowspan=\"2\">WALL<br>THICK</th>\r\n        <th colspan=\"4\">DETAILED SPECIFICATION</th>\r\n        <th rowspan=\"2\">GLASS<br><span class=\"sub\">+ THICKNESS</span></th>\r\n        \r\n        <th rowspan=\"2\">OPENING</th>\r\n        <th rowspan=\"2\">REMARKS</th>\r\n      </tr>\r\n      <tr>\r\n        <th>PROFILE</th>\r\n        <th>LOCK</th>\r\n        <th>HANDLE</th>\r\n        <th>HINGES</th>\r\n      </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n    {% for row in doc.measurement_items %}\r\n\r\n      {% set w1 = (row.custom_width1)|float %}\r\n      {% set w2 = (row.custom_width2)|float %}\r\n      {% set w3 = (row.custom_width3)|float %}\r\n      {% set h1 = (row.custom_height1)|float %}\r\n      {% set h2 = (row.custom_height2)|float %}\r\n      {% set h3 = (row.custom_height3)|float %}\r\n\r\n      {% set widths = [w1 if w1 else none, w2 if w2 else none, w3 if w3 else none] | select('ne', none) | list %}\r\n      {% set heights = [h1 if h1 else none, h2 if h2 else none, h3 if h3 else none] | select('ne', none) | list %}\r\n\r\n      {% set w_min = widths|min if widths|length else none %}\r\n      {% set w_max = widths|max if widths|length else none %}\r\n      {% set h_min = heights|min if heights|length else none %}\r\n      {% set h_max = heights|max if heights|length else none %}\r\n      {% set dW = (w_max - w_min) if (w_min is not none and w_max is not none) else none %}\r\n      {% set dH = (h_max - h_min) if (h_min is not none and h_max is not none) else none %}\r\n\r\n      {# fetch item image from Item master #}\r\n      {% set item_img = frappe.db.get_value('Item', row.item_code, 'image') %}\r\n      {% set img_url = frappe.utils.get_url(item_img) if item_img else None %}\r\n\r\n      <tr>\r\n        <td class=\"center\">{{ row.idx }}</td>\r\n\r\n        \r\n        \r\n        \r\n        <!-- ITEM CODE + CUSTOM ITEM NAME -->\r\n        <td>\r\n          {{ row.item_code or \"-\" }}\r\n          {% if row.custom_item_name %}\r\n            <br><span style=\"font-size:8px; color:#374151;\">{{ row.custom_item_name }}</span><br>\r\n          {% endif %}\r\n          \r\n          {% if row.custom_square_feet %}\r\n            <br><span style=\"font-size:8px; color:#111;\">(Sq.ft)<b><br>{{ row.custom_square_feet }} </b></span>\r\n          {% endif %}\r\n        </td>\r\n\r\n\r\n        <!-- ITEM IMAGE -->\r\n        <td class=\"imgbox\">\r\n          {% if img_url %}\r\n            <img src=\"{{ img_url }}\" alt=\"Item Image\">\r\n          {% else %}\r\n            -\r\n          {% endif %}\r\n        </td>\r\n        \r\n        \r\n       \r\n        \r\n        <!-- IMAGE ATTACH with Dimensions -->\r\n        <td>\r\n        {% if row.custom_attach %}\r\n          <div class=\"attach-wrap\">\r\n            <img src=\"{{ frappe.utils.get_url(row.custom_attach) }}\" alt=\"Measurement Image\">\r\n        \r\n            {# WIDTH LINES #}\r\n            {% if row.custom_width1 %}\r\n              <div class=\"h-line w1-line\"></div>\r\n              <div class=\"dim-label\" style=\"top:6%; left:50%; transform:translateX(-50%);\">\r\n                W1: {{ \"{:,.1f}\".format(row.custom_width1) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n            {% if row.custom_width2 %}\r\n              <div class=\"h-line w2-line\"></div>\r\n              <div class=\"dim-label\" style=\"top:44%; left:50%; transform:translateX(-50%);\">\r\n                W2: {{ \"{:,.1f}\".format(row.custom_width2) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n            {% if row.custom_width3 %}\r\n              <div class=\"h-line w3-line\"></div>\r\n              <div class=\"dim-label\" style=\"bottom:6%; left:50%; transform:translateX(-50%);\">\r\n                W3: {{ \"{:,.1f}\".format(row.custom_width3) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n            {# HEIGHT LINES #}\r\n            {% if row.custom_height1 %}\r\n              <div class=\"v-line h1-line\"></div>\r\n              <div class=\"dim-label\" style=\"top:50%; left:6%; transform:translate(-50%,-50%);\">\r\n                H1: {{ \"{:,.1f}\".format(row.custom_height1) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n            {% if row.custom_height2 %}\r\n              <div class=\"v-line h2-line\"></div>\r\n              <div class=\"dim-label\" style=\"top:50%; left:50%; transform:translate(-50%,-50%);\">\r\n                H2: {{ \"{:,.1f}\".format(row.custom_height2) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n            {% if row.custom_height3 %}\r\n              <div class=\"v-line h3-line\"></div>\r\n              <div class=\"dim-label\" style=\"top:50%; right:6%; transform:translate(50%,-50%);\">\r\n                H3: {{ \"{:,.1f}\".format(row.custom_height3) }}\r\n              </div>\r\n            {% endif %}\r\n        \r\n          </div>\r\n        {% else %}\r\n          -\r\n        {% endif %}\r\n        </td>\r\n\r\n\r\n\r\n\r\n\r\n        \r\n        \r\n\r\n\r\n        <!-- LOCATION -->\r\n        <td>\r\n          <div><b>Floor:</b> {{ row.custom_floor or \"-\" }}</div>\r\n          <div><b>Type:</b> {{ row.custom_type_of_place or \"-\" }}</div>\r\n          <div><b>Place:</b> {{ row.custom_place or \"-\" }}</div>\r\n        </td>\r\n\r\n        \r\n        \r\n        <!-- WIDTH -->\r\n        <!--<td>-->\r\n        <!--  {% if \"Combination\" in (row.custom_item_name or \"\") %}-->\r\n        <!--      {{ (row.custom_measurements or \"-\") | replace('\\n', '<br>') }}-->\r\n        <!--  {% else %}-->\r\n        <!--      {% if widths|length %}-->\r\n        <!--        {% if w1 %}W1: <b>{{ \"{:,.1f}\".format(w1) }}</b><br>{% endif %}-->\r\n        <!--        {% if w2 %}W2: <b>{{ \"{:,.1f}\".format(w2) }}</b><br>{% endif %}-->\r\n        <!--        {% if w3 %}W3: <b>{{ \"{:,.1f}\".format(w3) }}</b>{% endif %}-->\r\n        <!--      {% else %}-->\r\n        <!--        --->\r\n        <!--      {% endif %}-->\r\n        <!--  {% endif %}-->\r\n        <!--</td>-->\r\n        \r\n        <!--<td class=\"center\">{% if dW is not none %}{{ \"{:,.1f}\".format(dW) }}{% else %}-{% endif %}</td>-->\r\n\r\n        \r\n        \r\n        <!-- HEIGHT -->\r\n        <!--<td>-->\r\n        <!--  {% if \"Combination\" in (row.custom_item_name or \"\") %}-->\r\n        <!--      --->\r\n        <!--  {% else %}-->\r\n        <!--      {% if heights|length %}-->\r\n        <!--        {% if h1 %}H1: <b>{{ \"{:,.1f}\".format(h1) }}</b><br>{% endif %}-->\r\n        <!--        {% if h2 %}H2: <b>{{ \"{:,.1f}\".format(h2) }}</b><br>{% endif %}-->\r\n        <!--        {% if h3 %}H3: <b>{{ \"{:,.1f}\".format(h3) }}</b>{% endif %}-->\r\n        <!--      {% else %}-->\r\n        <!--        --->\r\n        <!--      {% endif %}-->\r\n        <!--  {% endif %}-->\r\n        <!--</td>-->\r\n        \r\n        \r\n        \r\n        <!--<td class=\"center\">{% if dH is not none %}{{ \"{:,.1f}\".format(dH) }}{% else %}-{% endif %}</td>-->\r\n        \r\n        \r\n        <!--New code changed on 1/06/2026 below starts-->\r\n        \r\n        {% if \"Combination\" in (row.custom_item_name or \"\") %}\r\n\r\n            <td colspan=\"4\" style=\"font-size:9px; line-height:1.4;\">\r\n                {{ (row.custom_measurements or \"-\") | replace('\\n', '<br>') }}\r\n            </td>\r\n        \r\n        {% else %}\r\n        \r\n            <!-- WIDTH -->\r\n            <td>\r\n              {% if widths|length %}\r\n                {% if w1 %}W1: <b>{{ \"{:,.1f}\".format(w1) }}</b><br>{% endif %}\r\n                {% if w2 %}W2: <b>{{ \"{:,.1f}\".format(w2) }}</b><br>{% endif %}\r\n                {% if w3 %}W3: <b>{{ \"{:,.1f}\".format(w3) }}</b>{% endif %}\r\n              {% else %}\r\n                -\r\n              {% endif %}\r\n            </td>\r\n        \r\n            <!-- \u0394W -->\r\n            <td class=\"center\">\r\n              {% if dW is not none %}\r\n                {{ \"{:,.1f}\".format(dW) }}\r\n              {% else %}\r\n                -\r\n              {% endif %}\r\n            </td>\r\n        \r\n            <!-- HEIGHT -->\r\n            <td>\r\n              {% if heights|length %}\r\n                {% if h1 %}H1: <b>{{ \"{:,.1f}\".format(h1) }}</b><br>{% endif %}\r\n                {% if h2 %}H2: <b>{{ \"{:,.1f}\".format(h2) }}</b><br>{% endif %}\r\n                {% if h3 %}H3: <b>{{ \"{:,.1f}\".format(h3) }}</b>{% endif %}\r\n              {% else %}\r\n                -\r\n              {% endif %}\r\n            </td>\r\n        \r\n            <!-- \u0394H -->\r\n            <td class=\"center\">\r\n              {% if dH is not none %}\r\n                {{ \"{:,.1f}\".format(dH) }}\r\n              {% else %}\r\n                -\r\n              {% endif %}\r\n            </td>\r\n        \r\n        {% endif %}\r\n        \r\n        \r\n        <!--New code changed on 1/06/2026 above ends-->\r\n\r\n        <!-- WALL THICK -->\r\n        <td class=\"center\">{{ row.custom_wall_thickness or row.wall_thick or \"-\" }}</td>\r\n\r\n        <!-- SPEC -->\r\n        <td class=\"center\">{{ row.custom_window or row.custom_profile or row.profile or \"-\" }}</td>\r\n        <td class=\"center\">{{ row.custom_lock or row.lock or \"-\" }}</td>\r\n        <td class=\"center\">{{ row.custom_handle or row.handle or \"-\" }}</td>\r\n        <td class=\"center\">{{ row.custom_hinges or row.hinges or \"-\" }}</td>\r\n\r\n        <!-- GLASS + THICKNESS -->\r\n        <td class=\"center\">\r\n          {% set gdesign = row.custom_glass_design or row.custom_design or row.design %}\r\n          {% set gthick  = row.custom_glass_thickness %}\r\n          {% set gcolor  = row.custom_color %}\r\n          {% set gtoughen  = row.custom_toughen %}\r\n          \r\n          {% if gdesign %}<b>Glass:</b> {{ gdesign }}{% if gthick %}<br>{% endif %}{% endif %}\r\n          {% if gthick %}<b>Thickness:</b> {{ gthick }}<br>{% endif %}\r\n          {% if gcolor %}<b>Color:</b> {{ gcolor }}<br>{% endif %}\r\n          {% if gtoughen %}<b>Toughen:</b> {{ gtoughen }}<br>{% endif %}\r\n          {% if not (gdesign or gthick) %}-{% endif %}\r\n        </td>\r\n\r\n        <!--OPENING-->\r\n        <td>{{ row.custom_opening or \"-\" }}</td>\r\n        <!-- REMARKS -->\r\n        <td>{{ row.custom_remarks or row.remarks or \"-\" }}</td>\r\n        \r\n      </tr>\r\n    {% endfor %}\r\n    </tbody>\r\n  </table>\r\n  \r\n  \r\n  \r\n  <br><br>\r\n<table style=\"width:100%; font-size:10px; border-collapse:collapse; margin-top:4mm;\">\r\n  <tr>\r\n    <td style=\"width:50%; vertical-align:top; padding:4px;\">\r\n      <b>Customer Name:</b> {{ doc.customer_name or \"-\" }}<br>\r\n      <b>Contact Number:</b> {{ doc.contact_number or \"-\" }}\r\n    </td>\r\n\r\n    <td style=\"width:50%; vertical-align:top; text-align:right; padding:4px;\">\r\n      \r\n      <b>Technician:</b>\r\n        {{ doc.technician.split('@')[0] if doc.technician else \"-\" }}<br>\r\n      <b>Completed Date:</b> {{ frappe.utils.format_date(doc.completed_date) if doc.completed_date else \"-\" }}\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n  \r\n  \r\n  \r\n  \r\n</div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
 "idx": 0,
